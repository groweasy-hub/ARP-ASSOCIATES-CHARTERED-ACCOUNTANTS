PORT=5000
MONGODB_URI=your-mongodb-connection-string
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password

# Gmail app-password SMTP settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-gmail-app-password
EMAIL_FROM="ARP Associates <your-gmail-address@gmail.com>"

# Public frontend URL for CORS and email logo loading
CLIENT_URL=https://www.arpassociate.in
EMAIL_LOGO_URL=https://res.cloudinary.com/dygjhlvlg/image/upload/v1785916274/ca-logo_ofy8kv.png
